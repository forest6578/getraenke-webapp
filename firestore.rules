// =============================================================
//  Firestore-Sicherheitsregeln
//  -------------------------------------------------------------
//  In der Firebase Console eintragen:
//    Firestore Database -> Regeln (Rules) -> Inhalt ersetzen ->
//    "Veröffentlichen" (Publish).
//
//  Bedeutung:
//   - "kunden" (aktive Aufträge): jeder ANGEMELDETE liest (Kasse); nur der
//     Arbeiter (feste UID) erstellt/ändert. Löschen darf jeder Angemeldete –
//     die Kasse löscht beim Abschließen, der Arbeiter beim Verwerfen.
//   - "archiv" (abgeschlossene Aufträge): jeder Angemeldete lesen/anlegen/
//     löschen (Anlegen beim Abschließen, Löschen beim Aufräumen > 1 Woche);
//     Ändern ist gesperrt.
//   - Die UID muss mit ARBEITER_UID in firebase-config.js übereinstimmen.
// =============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /kunden/{doc} {
      allow read:          if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == "e0fQWeqgdVM28gy0vGeNsJmQZ3x2";
      allow delete:         if request.auth != null;
    }

    match /archiv/{doc} {
      allow read, create, delete: if request.auth != null;
      allow update:               if false;
    }

  }
}
